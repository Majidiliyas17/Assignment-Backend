# Application
NODE_ENV=development
PORT=4000

# Database (Neon PostgreSQL)
DATABASE_URL=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload limits
MAX_FILE_SIZE_MB=500
# Optional comma-separated allowlist override (e.g. jpg,png,pdf). Leave empty for defaults.
ALLOWED_EXTENSIONS=

# CORS (comma-separated origins allowed, or *)
CORS_ORIGIN=http://localhost:3000

# Base URL used to build shareable links
APP_BASE_URL=http://localhost:4000